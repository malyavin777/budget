<?xml version="1.0" encoding="utf-8"?>
<!-- Кнопка «report»: тёмная основа + радиальное свечение сверху справа -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF0C0F22" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:type="radial"
                android:centerX="0.68"
                android:centerY="0.12"
                android:gradientRadius="160dp"
                android:startColor="#FF9B5CFF"
                android:centerColor="#FF3D7BFF"
                android:endColor="#003D7BFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="#24FFFFFF" />
        </shape>
    </item>
</layer-list>
